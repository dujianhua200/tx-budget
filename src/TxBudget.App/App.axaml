<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wvm="clr-namespace:TxBudget.App.Workbench.ViewModels;assembly=TxBudget.App.Workbench"
             x:Class="TxBudget.App.App">
    <!-- 通算宝设计语言调色板（borrowed from comm-budget-desktop renderer/app.css） -->
    <Application.Resources>
        <SolidColorBrush x:Key="C.Primary">#0E7C7B</SolidColorBrush>
        <SolidColorBrush x:Key="C.PrimaryDark">#0A5F5E</SolidColorBrush>
        <SolidColorBrush x:Key="C.Accent">#F2A900</SolidColorBrush>
        <SolidColorBrush x:Key="C.Danger">#C0392B</SolidColorBrush>
        <SolidColorBrush x:Key="C.Success">#2E8B57</SolidColorBrush>
        <SolidColorBrush x:Key="C.Bg">#F2F5F4</SolidColorBrush>
        <SolidColorBrush x:Key="C.Card">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="C.Text">#1F2D2B</SolidColorBrush>
        <SolidColorBrush x:Key="C.Muted">#6B7C79</SolidColorBrush>
        <SolidColorBrush x:Key="C.Line">#E2E8E6</SolidColorBrush>
        <SolidColorBrush x:Key="C.Sidebar">#10312F</SolidColorBrush>
        <SolidColorBrush x:Key="C.SidebarText">#B8C8C5</SolidColorBrush>
        <SolidColorBrush x:Key="C.HeaderBg">#F2F5F4</SolidColorBrush>
        <SolidColorBrush x:Key="C.TotalBg">#FFF7E6</SolidColorBrush>
    </Application.Resources>
    <Application.DataTemplates>
        <!-- 工程信息 -->
        <DataTemplate DataType="{x:Type wvm:ProjectInfoViewModel}">
            <ScrollViewer>
                <Grid Margin="10" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="建设单位" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding 建设单位}" Margin="4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="建设项目名称" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding 建设项目名称}" Margin="4"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="单项工程名称" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding 单项工程名称}" Margin="4"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="合同编号" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding 合同编号}" Margin="4"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="工程类型" VerticalAlignment="Center" Margin="4"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding 工程类型Options}" SelectedItem="{Binding 工程类型}" Margin="4"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="施工折扣" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding 施工折扣}" Margin="4"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="甲供增值税" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding 甲供增值税}" Margin="4"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="乙供增值税" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding 乙供增值税}" Margin="4"/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="冬雨季施工费" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding 冬雨季施工费}" Margin="4"/>
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="施工距离" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding 施工距离}" Margin="4"/>
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="施工实际里程" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding 施工实际里程}" Margin="4"/>
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="施工调遣分类" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding 施工调遣分类}" Margin="4"/>
                </Grid>
            </ScrollViewer>
        </DataTemplate>

        <!-- 表三甲·定额 -->
        <DataTemplate DataType="{x:Type wvm:Table3AViewModel}">
            <DockPanel Margin="4">
                <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="4" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="插入行" Command="{Binding InsertRowCommand}" Padding="8,4"/>
                        <Button Content="删除行" Command="{Binding DeleteRowCommand}" Padding="8,4"/>
                        <Button Content="替换定额" Command="{Binding ReplaceQuotaCommand}" Padding="8,4"/>
                        <Button Content="选择定额" Command="{Binding PickQuotaCommand}" Padding="8,4"/>
                        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All" BorderThickness="1" BorderBrush="#C0C0C0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding Source.Id}" Width="100"/>
                        <DataGridTextColumn Header="定额编号" Binding="{Binding Quota}" Width="120"/>
                        <DataGridTextColumn Header="定额名称" Binding="{Binding Variant}" Width="*"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Source.Unit}" Width="80"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="100"/>
                        <DataGridTextColumn Header="系数" Binding="{Binding Coef}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <!-- 表三乙·机械台班 -->
        <DataTemplate DataType="{x:Type wvm:Table3BViewModel}">
            <DockPanel Margin="4">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Total, StringFormat='合计: {0}'}" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="定额" Binding="{Binding Quota}" Width="*"/>
                        <DataGridTextColumn Header="定额名称" Binding="{Binding QuotaName}" Width="2*"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="*"/>
                        <DataGridTextColumn Header="设备名称" Binding="{Binding EquipName}" Width="2*"/>
                        <DataGridTextColumn Header="设备单位" Binding="{Binding EquipUnit}" Width="*"/>
                        <DataGridTextColumn Header="消耗量" Binding="{Binding Consumption}" Width="*"/>
                        <DataGridTextColumn Header="单价" Binding="{Binding Price}" Width="*"/>
                        <DataGridTextColumn Header="台班数" Binding="{Binding Sessions}" Width="*"/>
                        <DataGridTextColumn Header="金额" Binding="{Binding Amount}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <!-- 表三丙·仪器仪表 -->
        <DataTemplate DataType="{x:Type wvm:Table3CViewModel}">
            <DockPanel Margin="4">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Total, StringFormat='合计: {0}'}" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="定额" Binding="{Binding Quota}" Width="*"/>
                        <DataGridTextColumn Header="定额名称" Binding="{Binding QuotaName}" Width="2*"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="*"/>
                        <DataGridTextColumn Header="仪表名称" Binding="{Binding EquipName}" Width="2*"/>
                        <DataGridTextColumn Header="仪表单位" Binding="{Binding EquipUnit}" Width="*"/>
                        <DataGridTextColumn Header="消耗量" Binding="{Binding Consumption}" Width="*"/>
                        <DataGridTextColumn Header="单价" Binding="{Binding Price}" Width="*"/>
                        <DataGridTextColumn Header="台班数" Binding="{Binding Sessions}" Width="*"/>
                        <DataGridTextColumn Header="金额" Binding="{Binding Amount}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <!-- 表四甲·甲供材料 -->
        <DataTemplate DataType="{x:Type wvm:Table4AViewModel}">
            <DockPanel Margin="4">
                <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="4" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding TotalExcl, StringFormat='不含税合计: {0}'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalVat, StringFormat='增值税合计: {0}'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalIncl, StringFormat='含税合计: {0}'}" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All" BorderThickness="1" BorderBrush="#C0C0C0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="代号" Binding="{Binding Key}" Width="80"/>
                        <DataGridTextColumn Header="材料名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="规格型号" Binding="{Binding Spec}" Width="120"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="80"/>
                        <DataGridTextColumn Header="除税价格" Binding="{Binding PriceExcl}" Width="80"/>
                        <DataGridTextColumn Header="材料金额" Binding="{Binding AmtExcl}" Width="80"/>
                        <DataGridTextColumn Header="增值税额" Binding="{Binding AmtVat}" Width="80"/>
                        <DataGridTextColumn Header="含税金额" Binding="{Binding AmtIncl}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <!-- 表四乙·乙供材料 -->
        <DataTemplate DataType="{x:Type wvm:Table4BViewModel}">
            <DockPanel Margin="4">
                <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="4" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding TotalExcl, StringFormat='不含税合计: {0}'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalVat, StringFormat='增值税合计: {0}'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalIncl, StringFormat='含税合计: {0}'}" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All" BorderThickness="1" BorderBrush="#C0C0C0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="代号" Binding="{Binding Key}" Width="80"/>
                        <DataGridTextColumn Header="材料名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="规格型号" Binding="{Binding Spec}" Width="120"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="80"/>
                        <DataGridTextColumn Header="除税价格" Binding="{Binding PriceExcl}" Width="80"/>
                        <DataGridTextColumn Header="材料金额" Binding="{Binding AmtExcl}" Width="80"/>
                        <DataGridTextColumn Header="增值税额" Binding="{Binding AmtVat}" Width="80"/>
                        <DataGridTextColumn Header="含税金额" Binding="{Binding AmtIncl}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <!-- 双表二·取费 -->
        <DataTemplate DataType="{x:Type wvm:Table2ViewModel}">
            <DockPanel Margin="4">
                <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="4" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="打折模板：" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DiscountTemplateOptions}" SelectedItem="{Binding SelectedTemplate}" Width="200"/>
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="#E8E8F8" Padding="4">
                            <TextBlock Text="表二（折扣前）" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Before}" AutoGenerateColumns="False"
                                  CanUserSortColumns="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#C0C0C0" Margin="0,0,2,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Binding="{Binding Key}" Width="2*"/>
                                <DataGridTextColumn Header="折前金额" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="#E8F8E8" Padding="4">
                            <TextBlock Text="表二（折扣后）" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding After}" AutoGenerateColumns="False"
                                  CanUserSortColumns="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#C0C0C0" Margin="2,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Binding="{Binding Key}" Width="2*"/>
                                <DataGridTextColumn Header="折后金额" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- 表一·预算汇总 -->
        <DataTemplate DataType="{x:Type wvm:Table1ViewModel}">
            <Grid Margin="10" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="折前合计" Margin="4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BeforeDiscount}" Margin="4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="折后合计" Margin="4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AfterDiscount}" Margin="4"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="税前(折前)" Margin="4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxBefore}" Margin="4"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="税前(折后)" Margin="4"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TaxAfter}" Margin="4"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="不含税汇总" Margin="4"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SumExcl}" Margin="4"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="增值税汇总" Margin="4"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SumVat}" Margin="4"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="含税汇总" Margin="4"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SumIncl}" Margin="4"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="最终含税" Margin="4"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding GrandIncl}" Margin="4"/>
                <TextBlock Grid.Row="8" Grid.Column="0" Text="其他费" Margin="4"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding OtherFee}" Margin="4"/>
            </Grid>
        </DataTemplate>

        <!-- 表五甲·其他费用 -->
        <DataTemplate DataType="{x:Type wvm:Table5ViewModel}">
            <DockPanel Margin="4">
                <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="4" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding SafetyFee, StringFormat='安全生产费: {0}'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalExcl, StringFormat='不含税合计: {0}'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalVat, StringFormat='增值税合计: {0}'}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalIncl, StringFormat='含税合计: {0}'}" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All" BorderThickness="1" BorderBrush="#C0C0C0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Order}" Width="60"/>
                        <DataGridTextColumn Header="费用名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="单价计算式" Binding="{Binding Basis}" Width="*"/>
                        <DataGridTextColumn Header="费率" Binding="{Binding Rate}" Width="80"/>
                        <DataGridTextColumn Header="除税合计" Binding="{Binding Excl}" Width="100"/>
                        <DataGridTextColumn Header="含税合计" Binding="{Binding Incl}" Width="100"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="100"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <!-- 汇总表 -->
        <DataTemplate DataType="{x:Type wvm:SummaryViewModel}">
            <DockPanel Margin="4">
                <Border DockPanel.Dock="Top" Background="#E8E8F8" Padding="4" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1">
                    <TextBlock Text="工程汇总" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          CanUserSortColumns="False" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#C0C0C0"
                          Margin="0,4,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单位工程名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="建安工程费(不含税)" Binding="{Binding ConstructionExcl}" Width="120"/>
                        <DataGridTextColumn Header="建安工程费(增值税)" Binding="{Binding ConstructionVat}" Width="120"/>
                        <DataGridTextColumn Header="建安工程费(含税)" Binding="{Binding ConstructionIncl}" Width="120"/>
                        <DataGridTextColumn Header="其他费(不含税)" Binding="{Binding Other}" Width="100"/>
                        <DataGridTextColumn Header="其他费(增值税)" Binding="{Binding OtherVat}" Width="100"/>
                        <DataGridTextColumn Header="其他费(含税)" Binding="{Binding OtherIncl}" Width="100"/>
                        <DataGridTextColumn Header="总计(含税)" Binding="{Binding TotalIncl}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TxBudget.App/Resources/Styles.axaml" />
    </Application.Styles>
</Application>
