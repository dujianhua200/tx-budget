<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TxBudget.App.ViewModels"
        xmlns:wvm="clr-namespace:TxBudget.App.Workbench.ViewModels;assembly=TxBudget.App.Workbench"
        x:Class="TxBudget.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="通算宝 · 通信工程概预算 v4.0" Height="800" Width="1400"
        Background="{DynamicResource C.Bg}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" Name="MainMenu">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建工程(_N)" Command="{Binding NewCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="打开工程(_O)..." Command="{Binding OpenCommand}" InputGesture="Ctrl+O"/>
                <MenuItem Header="保存工程(_S)" Command="{Binding SaveCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="另存为(_A)..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="关闭工程(_G)" Command="{Binding CloseProjectCommand}"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Command="{Binding ExitCommand}" InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销(_U)" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z"/>
                <MenuItem Header="重做(_R)" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="查找(_F)..." Command="{Binding FindCommand}" InputGesture="Ctrl+F"/>
                <MenuItem Header="替换(_H)..." Command="{Binding ReplaceCommand}" InputGesture="Ctrl+H"/>
            </MenuItem>
            <MenuItem Header="工程(_P)">
                <MenuItem Header="工程信息(_I)" Command="{Binding ShowProjectInfoCommand}"/>
                <MenuItem Header="取费模板(_R)..." Command="{Binding ShowRateTemplateCommand}"/>
                <Separator/>
                <MenuItem Header="重新计算(_C)" Command="{Binding RecomputeCommand}" InputGesture="F5"/>
                <Separator/>
                <MenuItem Header="导出Excel(_E)..." Command="{Binding ExportExcelCommand}"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="定额输入(表三甲)" Command="{Binding ShowTable3ACommand}"/>
                <MenuItem Header="机械台班(表三乙)" Command="{Binding ShowTable3BCommand}"/>
                <MenuItem Header="仪器仪表(表三丙)" Command="{Binding ShowTable3CCommand}"/>
                <MenuItem Header="材料汇总(表四甲)" Command="{Binding ShowTable4ACommand}"/>
                <MenuItem Header="乙供材料(表四乙)" Command="{Binding ShowTable4BCommand}"/>
                <MenuItem Header="措施取费(表二)" Command="{Binding ShowTable2Command}"/>
                <MenuItem Header="预算汇总(表一)" Command="{Binding ShowTable1Command}"/>
                <MenuItem Header="其他费用(表五)" Command="{Binding ShowTable5Command}"/>
                <MenuItem Header="汇总表" Command="{Binding ShowSummaryCommand}"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="费率编辑(_R)..." Command="{Binding ShowRatesCommand}"/>
                <MenuItem Header="打折规则(_D)..." Command="{Binding ShowDiscountCommand}"/>
                <MenuItem Header="表五配置(_F)..." Command="{Binding ShowTable5ConfigCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于(_A)..." Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 快捷工具栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource C.Card}" Padding="6,4"
                BorderBrush="{DynamicResource C.Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="btn-ghost" Command="{Binding NewCommand}" ToolTip.Tip="新建工程 (Ctrl+N)">
                    <TextBlock Text="📄 新建"/>
                </Button>
                <Button Classes="btn-ghost" Command="{Binding OpenCommand}" ToolTip.Tip="打开工程 (Ctrl+O)">
                    <TextBlock Text="📂 打开"/>
                </Button>
                <Button Classes="btn-primary" Command="{Binding SaveCommand}" ToolTip.Tip="保存工程 (Ctrl+S)">
                    <TextBlock Text="💾 保存"/>
                </Button>
                <Separator Margin="6,0"/>
                <Button Classes="btn-accent" Command="{Binding RecomputeCommand}" ToolTip.Tip="重新计算 (F5)">
                    <TextBlock Text="🔄 计算"/>
                </Button>
                <Button Classes="btn-primary" Command="{Binding ExportExcelCommand}" ToolTip.Tip="导出概预算报表到 Excel">
                    <TextBlock Text="📤 导出 Excel"/>
                </Button>
                <Separator Margin="6,0"/>
                <Button Classes="btn-ghost" Command="{Binding ShowTable3ACommand}" ToolTip.Tip="表三甲·定额输入">
                    <TextBlock Text="定额输入"/>
                </Button>
                <Button Classes="btn-ghost" Command="{Binding ShowTable4ACommand}" ToolTip.Tip="表四甲·材料汇总">
                    <TextBlock Text="材料"/>
                </Button>
                <Button Classes="btn-ghost" Command="{Binding ShowTable2Command}" ToolTip.Tip="表二·措施取费">
                    <TextBlock Text="取费"/>
                </Button>
                <Button Classes="btn-ghost" Command="{Binding ShowTable1Command}" ToolTip.Tip="表一·预算汇总">
                    <TextBlock Text="表一"/>
                </Button>
                <Button Classes="btn-ghost" Command="{Binding ShowTable5Command}" ToolTip.Tip="表五·其他费用">
                    <TextBlock Text="其他费用"/>
                </Button>
                <Button Classes="btn-ghost" Command="{Binding ShowSummaryCommand}" ToolTip.Tip="汇总表">
                    <TextBlock Text="汇总"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 自检横幅 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource C.TotalBg}" Padding="6,3">
            <TextBlock Text="{Binding DiagBanner}" FontSize="12" Foreground="#664D03"/>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource C.Card}" Padding="6,4"
                BorderBrush="{DynamicResource C.Line}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource C.Text}"/>
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource C.Line}" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding ProjectPathDisplay, StringFormat='工程：{0}'}" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource C.Muted}"/>
                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource C.Line}" Margin="8,0"/>
                <TextBlock Grid.Column="4" Text="{Binding DirtyMarker, StringFormat='状态：{0}'}" VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Right"
                           Foreground="{DynamicResource C.Muted}"/>
                <ProgressBar Grid.Column="4" Width="100" Height="14" IsIndeterminate="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}" HorizontalAlignment="Right" Margin="4,0"/>
            </Grid>
        </Border>

        <!-- 主体：通算宝侧边栏 + 页签工作区 -->
        <Grid ColumnDefinitions="210,*">
            <!-- 深青侧边栏 -->
            <Border Grid.Column="0" Background="{DynamicResource C.Sidebar}">
                <DockPanel>
                    <!-- 侧边栏底部工具 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,12">
                        <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,0,0,10"/>
                        <Button Classes="nav-item" Command="{Binding ShowRatesCommand}">
                            <TextBlock Text="▦ 费率编辑"/>
                        </Button>
                        <Button Classes="nav-item" Command="{Binding ShowDiscountCommand}">
                            <TextBlock Text="▦ 打折规则"/>
                        </Button>
                        <Button Classes="nav-item" Command="{Binding ShowTable5ConfigCommand}">
                            <TextBlock Text="▦ 表五配置"/>
                        </Button>
                    </StackPanel>

                    <DockPanel>
                        <!-- Logo 区 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="18,18,18,16">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource C.Accent}">
                                <TextBlock Text="通" FontSize="22" FontWeight="Bold" Foreground="#10312F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="通算宝" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="通信工程概预算" FontSize="11" Foreground="#B3FFFFFF"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 导航 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,4" Spacing="0">
                                <Button Classes="nav-item" Command="{Binding ShowProjectInfoCommand}">
                                    <TextBlock Text="◧  工程信息"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable3ACommand}">
                                    <TextBlock Text="▤  定额输入"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable3BCommand}">
                                    <TextBlock Text="▤  机械台班"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable3CCommand}">
                                    <TextBlock Text="▤  仪器仪表"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable4ACommand}">
                                    <TextBlock Text="▦  材料汇总"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable4BCommand}">
                                    <TextBlock Text="▦  乙供材料"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable2Command}">
                                    <TextBlock Text="▣  措施取费"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable1Command}">
                                    <TextBlock Text="▣  预算汇总"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowTable5Command}">
                                    <TextBlock Text="▣  其他费用"/>
                                </Button>
                                <Button Classes="nav-item" Command="{Binding ShowSummaryCommand}">
                                    <TextBlock Text="⇶  汇总报表"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- 右侧工作区 -->
            <TabControl Grid.Column="1" Name="WorkbenchTabs"
                        Background="{DynamicResource C.Bg}"
                        Margin="12,8,12,4"
                        ItemsSource="{Binding OpenTabs}"
                        SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="wvm:WorkbenchTabViewModel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            <Button Content="×" Margin="6,0,0,0" Padding="2,0" MinWidth="20"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
